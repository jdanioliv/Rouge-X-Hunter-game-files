# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# --- Gemini (planner + second reviewer) ---
# NOT the same as a Gemini Advanced / Google AI Pro subscription - that's a
# separate consumer product with no API access. Get a free-tier key (no card
# required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Since an April 2026 policy change, the free tier is Flash-only - Pro-tier
# models (gemini-2.5-pro, any gemini-3.x-pro) 429 with "limit: 0" on a
# free-tier key no matter how little you've used. Stick to a Flash model
# here unless you've set up paid billing. Model IDs change often - if calls
# start 404ing or 429ing, check the current list/pricing at
# https://ai.google.dev/gemini-api/docs/models and update this, no code change needed.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# --- Claude Opus 5 (Claude Code CLI) ---
# Must be on PATH, or give an absolute path to claude.exe / claude
CLAUDE_BIN=claude
# Optional: force a specific model flag passed to `claude -p --model <this>`
CLAUDE_MODEL=

# --- Local Runner Server ---
RUNNER_PORT=4004
RUNNER_HOST=127.0.0.1


# --- Game Notes (Obsidian vault) ---
# Folder name (relative to repo root) that routerSync.js appends daily notes
# into. Default is fine unless you rename/move the vault.
OBSIDIAN_NOTES_DIR=GameNotes
