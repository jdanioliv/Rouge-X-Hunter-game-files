# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# --- Hermes (OpenRouter) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# "Hermes" is a persona, not a fixed model - point this at whatever OpenRouter
# model you want as the independent verifier. Current pick: Poolside's Laguna
# S 2.1 free tier, purpose-built for coding/agentic-coding use cases.
# (History: originally `stealth/ox-alpha`, an anonymous stealth model that
# OpenRouter revealed on 2026-08-26 to be Z.ai's GLM-5.3-Flash and moved to
# paid pricing - proof that "free" OpenRouter listings can change without
# notice. If this one stops being free too, swap the line below, no code
# change needed. GLM-5.3-Flash itself is still an option if you don't mind a
# small cost: ~$0.075/$0.25 per million input/output tokens as of Sep 2026,
# model id `z-ai/glm-5.3-flash`.)
OX_ALPHA_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Shown to OpenRouter for its leaderboards - harmless to leave as-is.
OPENROUTER_SITE_URL=http://127.0.0.1:4004
OPENROUTER_APP_NAME=RougeXHunter-Agentic-OS

# --- Gemini (planner + second reviewer) ---
# NOT the same as a Gemini Advanced / Google AI Pro subscription - that's a
# separate consumer product with no API access. Get a free-tier key (no card
# required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Since an April 2026 policy change, the free tier is Flash-only - Pro-tier
# models (gemini-2.5-pro, any gemini-3.x-pro) 429 with "limit: 0" on a
# free-tier key no matter how little you've used. Stick to a Flash model
# here unless you've set up paid billing. Model IDs change often - if calls
# start 404ing or 429ing, check the current list/pricing at
# https://ai.google.dev/gemini-api/docs/models and update this, no code change needed.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# --- Claude Opus 5 (Claude Code CLI) ---
# Must be on PATH, or give an absolute path to claude.exe / claude
CLAUDE_BIN=claude
# Optional: force a specific model flag passed to `claude -p --model <this>`
CLAUDE_MODEL=

# --- Local Runner Server ---
RUNNER_PORT=4004
RUNNER_HOST=127.0.0.1

# --- Routine schedules (cron syntax, evaluated in local server time) ---
NIGHTLY_AUDIT_CRON=0 2 * * *
WEEKLY_CLEANUP_CRON=0 3 * * 0

# --- Game Notes (Obsidian vault) ---
# Folder name (relative to repo root) that routerSync.js appends daily notes
# into. Default is fine unless you rename/move the vault.
OBSIDIAN_NOTES_DIR=GameNotes
