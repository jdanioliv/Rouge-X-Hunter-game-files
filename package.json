{
  "name": "rougexhunter-agentic-os",
  "version": "1.0.0",
  "private": true,
  "description": "Dual-Agent Peer-Review & Code Optimization Engine for RougeXHunter (Claude Opus 5 x Reviewer)",
  "main": "server/runner.js",
  "scripts": {
    "start": "node server/runner.js",
    "runner": "node server/runner.js",
    "co-optimize": "node scripts/co_optimizer.js",
    "dry-run": "node scripts/co_optimizer.js --dry-run --mode dual-code --prompt \"dry run smoke test\"",
    "update-memory": "node scripts/update_memory_index.js",
    "vault:new": "node scripts/vault_session.js new",
    "vault:index": "node scripts/vault_session.js index",
    "vault:status": "node scripts/vault_session.js status",
    "vault:publish": "node scripts/vault_session.js publish",
    "vault:lint": "node scripts/vault_lint.js",
    "vault:links": "node scripts/vault_links.js",
    "vault:graph": "node scripts/vault_graph.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
