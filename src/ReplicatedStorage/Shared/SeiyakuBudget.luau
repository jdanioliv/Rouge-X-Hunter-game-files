--!strict
-- Pure budget math and validation for Seiyaku builds (GDD section 4).
-- No Roblox APIs: unit-testable in plain Luau. The server re-validates every
-- build with these exact functions, so the client editor can preview costs
-- without being trusted.

local SeiyakuConfig = require(script.Parent.SeiyakuConfig)

local SeiyakuBudget = {}

-- Sums budget points generated by a list of condition ids.
-- Returns nil + reason on unknown or duplicate conditions.
function SeiyakuBudget.CalculateBudget(conditionIds: { string }): (number?, string?)
	local seen: { [string]: boolean } = {}
	local total = 0
	for _, id in conditionIds do
		local condition = SeiyakuConfig.ConditionsById[id]
		if not condition then
			return nil, `UnknownCondition:{tostring(id)}`
		end
		if seen[id] then
			return nil, `DuplicateCondition:{id}`
		end
		seen[id] = true
		total += condition.points
	end
	return total, nil
end

-- Sums point cost of modifier selections ({ id, tier? }).
-- Returns nil + reason on unknown modifiers, bad tiers, or duplicates.
function SeiyakuBudget.CalculateCost(modifiers: { { id: string, tier: number? } }): (number?, string?)
	local seen: { [string]: boolean } = {}
	local total = 0
	for _, selection in modifiers do
		local modifier = SeiyakuConfig.ModifiersById[selection.id]
		if not modifier then
			return nil, `UnknownModifier:{tostring(selection.id)}`
		end
		if seen[selection.id] then
			return nil, `DuplicateModifier:{selection.id}`
		end
		seen[selection.id] = true

		if modifier.tiers then
			local tier = selection.tier
			if type(tier) ~= "number" or not modifier.tiers[tier] then
				return nil, `InvalidTier:{selection.id}`
			end
			total += modifier.tiers[tier].cost
		else
			if selection.tier ~= nil then
				return nil, `UnexpectedTier:{selection.id}`
			end
			total += modifier.cost :: number
		end
	end
	return total, nil
end

export type ValidationResult = {
	ok: boolean,
	reason: string?,
	budget: number?,
	cost: number?,
}

-- Full build validation: structure, caps, and budget balance.
function SeiyakuBudget.ValidateBuild(build: any): ValidationResult
	if type(build) ~= "table" then
		return { ok = false, reason = "MalformedBuild" }
	end
	if type(build.conditionIds) ~= "table" or type(build.modifiers) ~= "table" then
		return { ok = false, reason = "MalformedBuild" }
	end
	if build.name ~= nil and type(build.name) ~= "string" then
		return { ok = false, reason = "MalformedBuild" }
	end

	if #build.conditionIds == 0 then
		return { ok = false, reason = "NoConditions" }
	end
	if #build.modifiers == 0 then
		return { ok = false, reason = "NoModifiers" }
	end
	if #build.conditionIds > SeiyakuConfig.MAX_CONDITIONS then
		return { ok = false, reason = "TooManyConditions" }
	end
	if #build.modifiers > SeiyakuConfig.MAX_MODIFIERS then
		return { ok = false, reason = "TooManyModifiers" }
	end

	local budget, budgetErr = SeiyakuBudget.CalculateBudget(build.conditionIds)
	if not budget then
		return { ok = false, reason = budgetErr }
	end

	local cost, costErr = SeiyakuBudget.CalculateCost(build.modifiers)
	if not cost then
		return { ok = false, reason = costErr }
	end

	if cost > budget then
		return { ok = false, reason = "OverBudget", budget = budget, cost = cost }
	end

	return { ok = true, budget = budget, cost = cost }
end

return SeiyakuBudget
